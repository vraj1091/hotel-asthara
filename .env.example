# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL) ───
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/asthara?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/asthara?sslmode=require"

# ─── Auth.js ───────────────────────────────────────────  generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ─── Guest ID encryption (AES-256-GCM, 32 bytes, base64) ─  generate: openssl rand -base64 32
ID_ENCRYPTION_KEY=

# ─── Seed: first Super Admin ───────────────────────────
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123
SEED_ADMIN_NAME=Hotel Owner

# ─── Seed: public contact details (leave empty to hide until set in admin) ───
HOTEL_PHONE=0124-6201611
HOTEL_WHATSAPP=
HOTEL_EMAIL=

# ─── Media storage (optional) ──────────────────────────
# Leave empty to store compressed uploads in the database (served from /media/…), which works on any host.
# Set all three to store uploads in Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email via Resend (optional) ───────────────────────
# Booking confirmations, hotel alerts, enquiry alerts and staff invites. Without a key nothing is sent,
# but every attempt is listed in Admin → Settings → Email log. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Hotel Asthara <bookings@yourdomain.com>"

# ─── Razorpay online payments (optional) ───────────────
# Keys saved in Admin → Settings → Payments take priority over these. With no keys, guests book with "Pay at hotel".
# Webhook URL to add in the Razorpay dashboard: https://<your-domain>/api/payments/razorpay/webhook
# (events: payment.captured and order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Google Maps Embed API (optional) ──────────────────
# Shows the hotel's named pin on the map. Without it, a key-free map of the exact coordinates is shown.
# Restrict the key to the Maps Embed API and your domain in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ─── Upstash Redis for rate limiting on serverless (optional) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
