// Hotel Asthara – database schema.
// All money is stored in paise (Int) to avoid floating point errors.
// Dates that represent a calendar day (check-in/out) use @db.Date and are
// handled as UTC midnight so "2026-12-24" is the same day on every server.

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // Rust-free query compiler, runs through @prisma/adapter-pg (works on Neon and Supabase)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL") // direct connection (migrations / db push)
}

// ───────────────────────── Enums ─────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  WALK_IN
  PHONE
  WHATSAPP
  OTHER
}

enum PaymentMethod {
  RAZORPAY
  PAY_AT_HOTEL
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum IdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENCE
  VOTER_ID
  OTHER_GOVT_ID
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

enum DiscountKind {
  PERCENT
  FLAT
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
}

enum PriceRuleKind {
  WEEKEND
  SEASONAL
  FESTIVAL
}

enum AdjustmentKind {
  PERCENT
  FIXED_RATE
}

enum MediaStorage {
  DATABASE // bytes in MediaBlob, served from /media/<id>.<ext> (works on any host, no extra service)
  CLOUDINARY // used automatically when CLOUDINARY_* keys are set
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED // no RESEND_API_KEY configured
}

// ───────────────────────── Staff & access ─────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // SUPER_ADMIN | MANAGER | RECEPTIONIST
  name        String
  permissions String[] // e.g. "bookings:read", see lib/permissions.ts
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  inviteToken  String?   @unique
  inviteExpiry DateTime?
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
  payments  Payment[]
  media     MediaAsset[]

  @@index([roleId])
  @@index([deletedAt])
}

// ───────────────────────── Rooms & inventory ─────────────────────────

model RoomType {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameHi        String?
  summary       String
  summaryHi     String?
  description   String
  descriptionHi String?
  sizeSqFt      Int
  maxAdults     Int      @default(2)
  maxChildren   Int      @default(1)
  bedType       String
  baseRatePaise Int
  extraBedPaise Int?
  amenities     String[] // keys from lib/amenities.ts
  featured      Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms        Room[]
  images       RoomImage[]
  priceRules   PriceRule[]
  blocks       RoomBlock[]
  bookingRooms BookingRoom[]

  @@index([active, sortOrder])
  @@index([deletedAt])
}

model Room {
  id         String     @id @default(cuid())
  number     String     @unique
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  floor      Int        @default(2)
  status     RoomStatus @default(ACTIVE)
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookingRooms BookingRoom[]
  blocks       RoomBlock[]

  @@index([roomTypeId, status])
  @@index([deletedAt])
}

model RoomImage {
  id         String      @id @default(cuid())
  roomTypeId String
  roomType   RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  mediaId    String?
  media      MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  url        String
  publicId   String? // Cloudinary public id, used for deletion
  alt        String      @default("")
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([roomTypeId, sortOrder])
  @@index([mediaId])
}

// Weekend, seasonal and festival pricing. The highest-priority matching rule wins.
model PriceRule {
  id          String         @id @default(cuid())
  roomTypeId  String? // null = applies to every room type
  roomType    RoomType?      @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name        String
  kind        PriceRuleKind
  adjustment  AdjustmentKind @default(PERCENT)
  value       Int // PERCENT: +20 / -10, FIXED_RATE: paise per night
  startDate   DateTime?      @db.Date // null for WEEKEND rules
  endDate     DateTime?      @db.Date // inclusive
  daysOfWeek  Int[] // 0 = Sunday … 6 = Saturday (WEEKEND rules)
  priority    Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([roomTypeId, active])
  @@index([startDate, endDate])
}

// Blocks a single room (maintenance) or a whole room type (sold out) for a date range.
// endDate is exclusive, like a check-out date.
model RoomBlock {
  id         String    @id @default(cuid())
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([roomId, startDate, endDate])
  @@index([roomTypeId, startDate, endDate])
}

// ───────────────────────── Guests & bookings ─────────────────────────

model Guest {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String?
  idType        IdType?
  idNumberEnc   String? // AES-256-GCM ciphertext, see lib/crypto.ts
  idNumberLast4 String? // safe to show to every staff role
  city          String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings Booking[]

  @@index([phone])
  @@index([email])
  @@index([deletedAt])
}

model Booking {
  id              String        @id @default(cuid())
  reference       String        @unique // AST-261224-7K2F
  guestId         String
  guest           Guest         @relation(fields: [guestId], references: [id])
  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date // exclusive
  nights          Int
  adults          Int           @default(2)
  children        Int           @default(0)
  status          BookingStatus @default(PENDING)
  source          BookingSource @default(WEBSITE)
  subtotalPaise   Int
  discountPaise   Int           @default(0)
  taxPaise        Int
  totalPaise      Int
  couponCode      String?
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  paymentMethod   PaymentMethod @default(PAY_AT_HOTEL)
  specialRequests String?
  internalNotes   String?
  holdExpiresAt   DateTime? // online payment pending: rooms are released after this time
  confirmedAt     DateTime?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  invoiceNumber   String?       @unique
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rooms    BookingRoom[]
  payments Payment[]
  emails   EmailLog[]

  @@index([status, checkIn])
  @@index([checkIn, checkOut])
  @@index([guestId])
  @@index([createdAt])
  @@index([deletedAt])
}

model BookingRoom {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id])
  roomTypeId    String
  roomType      RoomType @relation(fields: [roomTypeId], references: [id])
  checkIn       DateTime @db.Date // copied from Booking so the DB can enforce no-overlap
  checkOut      DateTime @db.Date
  active        Boolean  @default(true) // false once cancelled / expired / no-show
  nightlyRates  Json // [{ date: "2026-12-24", ratePaise: 250000, rule: "Weekend" }]
  subtotalPaise Int
  taxPaise      Int
  createdAt     DateTime @default(now())

  @@index([roomId, checkIn, checkOut])
  @@index([bookingId])
  @@index([roomTypeId])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountPaise       Int
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  note              String?
  receivedById      String?
  receivedBy        User?         @relation(fields: [receivedById], references: [id])
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
  @@index([status, paidAt])
}

// ───────────────────────── Marketing & content ─────────────────────────

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  source    String        @default("contact") // contact | booking-request
  status    EnquiryStatus @default(NEW)
  readAt    DateTime?
  replyBody String?
  repliedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([deletedAt])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  kind             DiscountKind
  value            Int // PERCENT: 1–100, FLAT: paise
  maxDiscountPaise Int?
  minNights        Int          @default(1)
  minAmountPaise   Int          @default(0)
  usageLimit       Int?
  usedCount        Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean      @default(true)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  offers   Offer[]
  bookings Booking[]

  @@index([active, startsAt, endsAt])
  @@index([deletedAt])
}

model Offer {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  titleHi       String?
  description   String
  descriptionHi String?
  imageUrl      String?
  couponId      String?
  coupon        Coupon?   @relation(fields: [couponId], references: [id])
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([deletedAt])
}

model GalleryImage {
  id        String      @id @default(cuid())
  mediaId   String?
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  category  String      @default("hotel") // keys from Settings → gallery.categories
  alt       String      @default("")
  altHi     String      @default("")
  visible   Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([visible, category, sortOrder])
  @@index([deletedAt])
}

model Testimonial {
  id        String    @id @default(cuid())
  name      String
  location  String?
  rating    Int       @default(5)
  body      String
  source    String? // Google, MakeMyTrip, Direct …
  approved  Boolean   @default(false)
  featured  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([approved, featured])
  @@index([deletedAt])
}

// One row per homepage section. Admin reorders (sortOrder) and toggles (enabled).
model PageSection {
  id        String   @id @default(cuid())
  key       String   @unique // HERO | ROOMS_GRID | AMENITIES | …
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model Setting {
  key       String   @id // hotel | contact | policies | seo | gst | rating | amenities | nearby | faqs | pages
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Media library ─────────────────────────

model MediaAsset {
  id           String       @id @default(cuid())
  storage      MediaStorage @default(DATABASE)
  url          String // /media/<id>.webp or the Cloudinary secure URL
  publicId     String? // Cloudinary public id
  filename     String
  mime         String
  width        Int
  height       Int
  sizeBytes    Int
  alt          String       @default("")
  altHi        String       @default("")
  folder       String       @default("general") // hero | rooms | gallery | offers | general
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  blob          MediaBlob?
  roomImages    RoomImage[]
  galleryImages GalleryImage[]

  @@index([folder, createdAt])
  @@index([deletedAt])
}

// Image bytes live in their own table so listing the library never loads them.
model MediaBlob {
  mediaId String     @id
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  data    Bytes
}

// ───────────────────────── System ─────────────────────────

// Gap-free sequences, e.g. invoice numbers per financial year ("invoice:2026-27").
model Counter {
  key   String @id
  value Int    @default(0)
}

model EmailLog {
  id        String      @id @default(cuid())
  kind      String // booking.guest | booking.hotel | enquiry.reply | enquiry.hotel | staff.invite
  to        String
  subject   String
  status    EmailStatus
  error     String?
  bookingId String?
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([bookingId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "booking.cancel"
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
